# Copy to .env; set unique values and never commit the resulting file.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_python_-c_secrets.token_urlsafe_48
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

BACKEND_CORS_ORIGINS=["https://your-real-domain.example"]

POSTGRES_USER=armoire
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=armoire
DATABASE_URL=postgresql+asyncpg://armoire:REPLACE_WITH_URL_ESCAPED_PASSWORD@db:5432/armoire
SYNC_DATABASE_URL=postgresql+psycopg2://armoire:REPLACE_WITH_URL_ESCAPED_PASSWORD@db:5432/armoire

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/app/storage_data
S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.example
S3_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
S3_BUCKET_NAME=armoire-private-media
S3_REGION=auto

OPENWEATHER_API_KEY=REPLACE_WITH_OPENWEATHER_API_KEY
REPLICATE_API_TOKEN=
WEB_CONCURRENCY=2
APP_PORT=8000
