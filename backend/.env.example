# Application Settings
PROJECT_NAME="Smart Wardrobe & AI Recommendation System"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wardrobe_user
POSTGRES_PASSWORD=wardrobe_secure_password
POSTGRES_DB=smart_wardrobe
DATABASE_URL=postgresql+asyncpg://wardrobe_user:wardrobe_secure_password@localhost:5432/smart_wardrobe
SYNC_DATABASE_URL=postgresql+psycopg2://wardrobe_user:wardrobe_secure_password@localhost:5432/smart_wardrobe

# Redis Cache & Celery Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (S3 / Cloudflare R2 / Local fallback)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=smart-wardrobe-media
S3_REGION=auto

# External APIs
OPENWEATHER_API_KEY=
REPLICATE_API_TOKEN=

# Upload Limits & Quality Gate Thresholds
MAX_UPLOAD_SIZE_MB=15
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200
BLUR_THRESHOLD_GOOD=100.0
BLUR_THRESHOLD_BORDERLINE=50.0
BRIGHTNESS_MIN=40.0
BRIGHTNESS_MAX=220.0
